# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ddd_project
DB_USER=postgres
DB_PASSWORD=postgres

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=ddd_project.events

# Outbox relay
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=200
# How long a row can sit claimed ("sending") before a crashed relay
# instance's claim is assumed abandoned and given back to the pool.
OUTBOX_STALE_CLAIM_MS=60000

# Logging (trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# Metrics (GET /metrics) — app serves its own on PORT above
CONSUMER_METRICS_PORT=9091
OUTBOX_RELAY_METRICS_PORT=9092

# Tracing (OpenTelemetry -> Jaeger's OTLP receiver)
OTEL_SERVICE_NAME=ddd-cqrs-rabbitmq
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# API auth — every route except /health, /health/ready and /metrics requires
# this value in an X-API-Key header. Comma-separate multiple keys for
# multiple clients. If unset, it falls back to the well-known "local-dev-key"
# below (same as every other credential in this project) — that's fine for
# local dev, but set a real value before exposing this anywhere else, since
# an unset API_KEY in that case does NOT fail closed.
API_KEY=local-dev-key

# CORS — comma-separated allowed origins, or * to allow any (fine for local
# dev; set specific origins before exposing this publicly)
CORS_ORIGIN=*

# Rate limiting — applies per IP, above the API-key check so it also throttles
# brute-force attempts at guessing a key
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Application Configuration
NODE_ENV=development
PORT=3000

# Test Database (SQLite in memory)
TEST_DB_STORAGE=:memory: